{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Reporting": {
    "InrToNokNumerator": 12,
    "InrToNokDenominator": 100
  },
  "Budgets": {
    "Offices": {
      "1": { "Currency": "NOK", "MonthlyLimitMinor": 600000, "TimeZoneId": "Europe/Oslo" },
      "2": { "Currency": "INR", "MonthlyLimitMinor": 1500000, "TimeZoneId": "Asia/Kolkata" }
    }
  },
  "Invitations": {
    "NotificationCooldown": "01:00:00",
    "MaxInvitationAttempts": 6
  }
}
